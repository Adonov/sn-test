# Copy this file to ".env" and fill in the values. ".env" is never committed.

# Anthropic API key used by the server to translate recipes (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Where the iOS/Android apps reach the server that translates recipes.
# - iPhone simulator on this Mac: http://localhost:5173 (while `npm run dev` is running)
# - Published apps: the https address of the hosted server, e.g. https://forkful.example.com
VITE_API_URL=
