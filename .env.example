# Copy this file to ".env" and fill in the values. ".env" is never committed.

# Anthropic API key used by the server to translate recipes (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Where the iOS/Android apps reach the server that translates recipes.
# - iPhone simulator on this Mac: http://localhost:5173 (while `npm run dev` is running)
# - Published apps: the https address of the hosted server, e.g. https://taisty.example.com
VITE_API_URL=

# Accounts and sync (optional): from Supabase → Project Settings → API.
# The "anon" / "publishable" key is meant to be public; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Strava connection (optional): create an API application at https://www.strava.com/settings/api.
# For the simulator set "Authorization Callback Domain" there to localhost.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_DOMAIN=localhost
